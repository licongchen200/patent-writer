# API Keys for Patent Writing System

# Serper API Key (Required for web search)
# Get your free key at: https://serper.dev
# Free tier: 2,500 searches/month
SERPER_API_KEY=your-serper-api-key-here

# ============================================================================
# INTERNAL LLM PROXY (Comcast Kubernetes)
# ============================================================================
# Using internal llm-proxy service running on k8s
# This is OpenAI-compatible and doesn't require external API keys
OPENAI_API_BASE=http://llm-proxy.ceui.cnap.comcast.net/v1
OPENAI_API_KEY=dummy-key-not-needed

# Optional: Set specific model if your proxy supports multiple models
# OPENAI_MODEL_NAME=gpt-4

# ============================================================================
# ALTERNATIVE: External OpenAI API (if not using internal proxy)
# ============================================================================
# Uncomment to use external OpenAI instead of internal proxy
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL_NAME=gpt-4

# ============================================================================
# ALTERNATIVE: Anthropic Claude
# ============================================================================
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================================================
# ALTERNATIVE: Local Ollama
# ============================================================================
# OPENAI_API_BASE=http://localhost:11434
# OPENAI_MODEL_NAME=llama2

# Optional: Adjust verbosity
# CREWAI_VERBOSE=true
