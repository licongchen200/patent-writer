# API Keys for Patent Writing System

# Serper API Key (Required for web search)
# Get your free key at: https://serper.dev
# Free tier: 2,500 searches/month
SERPER_API_KEY=your-serper-api-key-here

# OpenAI API Key (Required for LLM)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Alternative: Ollama (for local LLM)
# OPENAI_API_BASE=http://localhost:11434
# OPENAI_MODEL_NAME=llama2

# Optional: Set specific OpenAI model
# OPENAI_MODEL_NAME=gpt-4
# OPENAI_MODEL_NAME=gpt-3.5-turbo

# Optional: Adjust verbosity
# CREWAI_VERBOSE=true
